# Postgres có pgvector (docker compose up -d sẽ tạo sẵn)
DATABASE_URL=postgresql://troly:troly@localhost:5432/troly

# https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
# https://dash.voyageai.com  (embedding cho bộ nhớ dài hạn)
VOYAGE_API_KEY=pa-...

# https://console.soniox.com  (STT + TTS cho hold-to-talk)
SONIOX_API_KEY=

# https://cloud.livekit.io → Settings → API keys (rảnh tay có khử tiếng vọng)
LIVEKIT_URL=wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Token tự đặt, chuỗi ngẫu nhiên dài. App mobile dùng token này để gọi backend.
# Tạo nhanh: python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_TOKEN=doi-thanh-chuoi-ngau-nhien

# Cách trợ lý gọi anh
USER_NAME=anh

# Tuỳ chọn
# UTILITY_MODEL=claude-haiku-5-5
# EMBED_MODEL=voyage-3.5
# STT_MODEL=stt-rt-v6
# TTS_MODEL=tts-rt-v2
# Giọng tiếng Việt: Linh (mặc định), Huong, Mai
# TTS_VOICE=Linh
